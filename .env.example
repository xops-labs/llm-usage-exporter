# llm-usage-exporter — example environment file.
#
# Every provider block is independently opt-in: leave a provider's required
# variables empty and that provider is not registered (no validation, no polling,
# no metrics). Enable only the providers you actually use.
#
# Step-by-step credential setup runbooks per cloud:
#   docs/credentials/openai.md      docs/credentials/azure-openai.md
#   docs/credentials/anthropic.md   docs/credentials/gemini.md
#   docs/credentials/aws-bedrock.md

# --- Exporter ---
EXPORTER_POLL_INTERVAL_SECONDS=300
EXPORTER_LOOKBACK_MINUTES=60

# --- Demo mode (synthetic data; for previewing dashboards without real credentials) ---
# When true, the exporter registers a synthetic "demo" provider that emits
# deterministic, time-of-day-modulated usage and cost across 5 fake models and
# 2 fake tenants — all labeled provider="demo" so it cannot be confused with
# real telemetry. Leave unset (or false) for any production deployment.
# DEMO_MODE_ENABLED=true

# --- OpenAI ---
# Required: admin API key with org-level usage / cost reporting access.
# Get one at https://platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_API_KEY=sk-admin-replace-me
# Optional: OPENAI_ORG_ID, OPENAI_PROJECT_IDS (csv), OPENAI_MODELS (csv).
# OPENAI_ORG_ID=org_replace_me
# OPENAI_PROJECT_IDS=proj_abc,proj_def

# --- Azure OpenAI (uncomment the entire block to enable) ---
# Required: an Azure AD service principal with
#   Microsoft.Insights/metrics/read on the Cognitive Services account, and
#   Microsoft.CostManagement/query/action on the subscription.
# AZURE_OPENAI_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_OPENAI_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_OPENAI_CLIENT_SECRET=replace-me
# AZURE_OPENAI_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# AZURE_OPENAI_ACCOUNT_RESOURCE_IDS=/subscriptions/.../resourceGroups/rg/providers/Microsoft.CognitiveServices/accounts/contoso-aoai
# AZURE_OPENAI_RESOURCE_GROUP=rg-aoai

# --- Anthropic Claude (uncomment the entire block to enable) ---
# Required: an Anthropic admin API key from https://console.anthropic.com/settings/admin-keys
# ANTHROPIC_ADMIN_API_KEY=sk-ant-admin-replace-me
# ANTHROPIC_VERSION=2023-06-01
# ANTHROPIC_WORKSPACE_IDS=wrkspc_xxx

# --- Google Gemini (uncomment the entire block to enable) ---
# Required: a GCP service account JSON keyfile path (OR a pre-issued OAuth2 access token).
# IAM roles: monitoring.viewer (always) + bigquery.dataViewer (only when cost queries on).
# GEMINI_PROJECT_ID=my-gcp-proj
# GEMINI_SERVICE_ACCOUNT_KEY_FILE=/secrets/gemini-sa.json
# GEMINI_ACCESS_TOKEN=ya29.short-lived-token            # alternative to keyfile
# GEMINI_ENABLE_COST_QUERIES=false                       # set true to add BigQuery billing-export queries
# GEMINI_BILLING_PROJECT_ID=my-gcp-proj
# GEMINI_BILLING_DATASET_PROJECT=billing-account-project
# GEMINI_BILLING_DATASET_ID=billing_export
# GEMINI_BILLING_TABLE=gcp_billing_export_v1_XXXXXX_XXXXXX_XXXXXX

# --- AWS Bedrock (uncomment the entire block to enable) ---
# Required: an IAM principal with cloudwatch:GetMetricData and ce:GetCostAndUsage.
# AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=replace-me
# AWS_SESSION_TOKEN=                                     # only when using STS / role-assumed creds
# AWS_REGION=us-east-1
# BEDROCK_MODEL_IDS=anthropic.claude-3-5-sonnet-20241022-v2:0,amazon.titan-text-express-v1
# BEDROCK_ENABLE_COST_QUERIES=true

# --- OpenTelemetry OTLP export (uncomment to enable) ---
# Setting OTEL_EXPORTER_OTLP_ENDPOINT activates a parallel OTLP pipeline for
# metrics + traces (W3C traceparent propagation through every provider HTTP call).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc                       # or http/protobuf
# OTEL_SERVICE_NAME=llm-usage-exporter
# OTEL_EXPORTER_OTLP_HEADERS=api-key=...                 # for managed OTel backends
#
# Trace context propagation (default: true).
# When true, W3C traceparent/tracestate headers are forwarded to every provider API call,
# which lets your tracing backend correlate exporter spans with provider-side latency.
# Set to false if your organization's data-governance or privacy policy prohibits
# sending internal trace IDs across vendor boundaries.
# OTEL_TRACE_CONTEXT_PROPAGATION_ENABLED=true

# --- Durable checkpoints (uncomment to switch off in-memory) ---
# In single-replica deployments, set CHECKPOINTS_PROVIDER=File and mount a
# writable volume at the path below for crash-restart safety.
# CHECKPOINTS_PROVIDER=File
# CHECKPOINTS_FILE_PATH=/data/checkpoints.jsonl

# --- Alerts (defaults on) ---
# ALERTS_ENABLED=true
# ALERTS_EVALUATION_INTERVAL_SECONDS=60
# ALERTS_ROLLING_WINDOW_BUCKETS=60

# --- FOCUS v1.0 export (defaults on) ---
# FOCUS_ENABLED=true
# FOCUS_MAX_RECORDS=50000
