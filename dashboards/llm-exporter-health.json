          },
          {
            "matcher": {
              "id": "byName",
              "options": "gemini"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-orange"
                }
              }
            ]
          },
          {
