{
  "title": "LLM Usage — Provider Deep Dive",
  "uid": "llm-provider-deep-dive",
  "tags": [
    "llm-usage-exporter",
    "provider",
    "deep-dive"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "DS_PROMETHEUS"},
        "query": "label_values(llm_usage_input_tokens_total, provider)",
        "multi": false,
        "includeAll": false,
        "refresh": 2,
        "current": {},
        "options": []
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "DS_PROMETHEUS"
        },
        "query": "label_values(llm_usage_input_tokens_total, tenant)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "DS_PROMETHEUS"
        },
        "query": "label_values(llm_usage_total_tokens_total{provider=\"$provider\",tenant=~\"$tenant\"}, model)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tokens (24h)",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(llm_usage_total_tokens_total{provider=\"$provider\",tenant=~\"$tenant\",model=~\"$model\"}[24h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cost (24h, USD)",
      "description": "Sourced from cost_usd_by_model_total so the $model filter applies. When $model=All this slightly under-counts line items the upstream did not attribute to a specific model (e.g. fine-tuning fees); use the unfiltered llm-cost-and-budgets dashboard for canonical totals.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(llm_usage_cost_usd_by_model_total{provider=\"$provider\",tenant=~\"$tenant\",model=~\"$model\"}[24h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests (24h)",
      "description": "Anthropic does not emit a request counter — this panel will be empty when provider=anthropic.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(llm_usage_requests_total{provider=\"$provider\",tenant=~\"$tenant\",model=~\"$model\"}[24h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cached input ratio (24h)",
      "description": "Only OpenAI and Anthropic expose a cached-input token counter — empty for azure_openai, gemini, bedrock.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 15,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(llm_usage_cached_input_tokens_total{provider=\"$provider\",tenant=~\"$tenant\",model=~\"$model\"}[24h])) / clamp_min(sum(increase(llm_usage_input_tokens_total{provider=\"$provider\",tenant=~\"$tenant\",model=~\"$model\"}[24h])), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Last poll duration (s)",
      "description": "Per-provider exporter metric — not affected by the $model filter.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "max(llm_exporter_last_poll_duration_seconds{provider=\"$provider\",tenant=~\"$tenant\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tokens by model over time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 1
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum by (model) (rate(llm_usage_total_tokens_total{provider=\"$provider\",tenant=~\"$tenant\",model=~\"$model\"}[15m]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cost by model over time (USD/hr)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 1
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum by (model) (rate(llm_usage_cost_usd_by_model_total{provider=\"$provider\",tenant=~\"$tenant\",model=~\"$model\"}[15m])) * 3600",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Input vs output tokens over time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30,
            "lineWidth": 1
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(llm_usage_input_tokens_total{provider=\"$provider\",tenant=~\"$tenant\",model=~\"$model\"}[15m]))",
          "legendFormat": "input",
          "refId": "A"
        },
        {
          "expr": "sum(rate(llm_usage_output_tokens_total{provider=\"$provider\",tenant=~\"$tenant\",model=~\"$model\"}[15m]))",
          "legendFormat": "output",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Request rate over time",
      "description": "Anthropic does not emit a request counter — this panel will be empty when provider=anthropic.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(llm_usage_requests_total{provider=\"$provider\",tenant=~\"$tenant\",model=~\"$model\"}[15m]))",
          "legendFormat": "req/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Top 10 models (24h)",
      "description": "When $model is set to a specific value, this table narrows to just that model.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "topk(10, sum by (model) (increase(llm_usage_total_tokens_total{provider=\"$provider\",tenant=~\"$tenant\",model=~\"$model\"}[24h])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sum by (model) (increase(llm_usage_cost_usd_by_model_total{provider=\"$provider\",tenant=~\"$tenant\",model=~\"$model\"}[24h]))",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "merge"
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true
            },
            "renameByName": {
              "Value #A": "tokens",
              "Value #B": "cost"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "tokens",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Per-tenant breakdown (24h)",
      "description": "Shows all tenants regardless of the $tenant filter (so you can see who else uses this provider). The $model filter does apply — pick a model to see per-tenant cost / tokens for that specific model.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "sum by (tenant) (increase(llm_usage_total_tokens_total{provider=\"$provider\",model=~\"$model\"}[24h]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sum by (tenant) (increase(llm_usage_cost_usd_by_model_total{provider=\"$provider\",model=~\"$model\"}[24h]))",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "merge"
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true
            },
            "renameByName": {
              "Value #A": "tokens",
              "Value #B": "cost"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "cost",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Exporter health — poll success vs failure rate",
      "description": "Per-provider exporter metric — not affected by the $model filter.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failure"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(llm_exporter_poll_success_total{provider=\"$provider\",tenant=~\"$tenant\"}[15m]))",
          "legendFormat": "success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(llm_exporter_poll_failure_total{provider=\"$provider\",tenant=~\"$tenant\"}[15m]))",
          "legendFormat": "failure",
          "refId": "B"
        }
      ]
    }
  ]
}
